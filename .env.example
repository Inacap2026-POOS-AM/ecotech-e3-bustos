# Copiar este archivo como .env y completar.
# El .env real NO se sube a GitHub (está en .gitignore).

# --- Supabase (base principal) ---
# Supabase -> botón "Connect" -> "Session pooler" -> URI (cambiar [YOUR-PASSWORD] por la clave de la BD)
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:TU_CLAVE@aws-0-xx.pooler.supabase.com:5432/postgres
# Certificado para verificar SSL (ver certs/LEEME.txt)
SUPABASE_CA_CERT=certs/prod-ca-2021.crt

# --- Copia local para el Plan B (sin internet) ---
DB_LOCAL=ecotech_local.db

# --- APIs externas (públicas, no piden llave) ---
URL_GEOCODING=https://geocoding-api.open-meteo.com/v1/search
URL_CLIMA=https://api.open-meteo.com/v1/forecast
URL_INDICADORES=https://mindicador.cl/api
# Solo si se cambia a una API que pida llave. Nunca escribirla en el código.
API_KEY_CLIMA=

# --- Resiliencia ---
HTTP_TIMEOUT_CONEXION=3.05
HTTP_TIMEOUT_LECTURA=10
HTTP_MAX_INTENTOS=3
HTTP_BACKOFF_BASE=1
HTTP_ESPERA_MAXIMA=30
